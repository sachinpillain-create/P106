# Auto-detect text files and normalize line endings
* text=auto

# Scripts and code
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.bat text eol=crlf
*.sh text eol=lf
*.eml text eol=crlf

# Binary assets
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.docx binary
*.bin binary
